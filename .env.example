APP_NAME=Task Manager API
DEBUG=false
AUTO_CREATE_SCHEMA=false
DATABASE_URL=sqlite+aiosqlite:///./tasks.db
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
GEOLOCATION_API_URL=https://ipwho.is
GEOLOCATION_TIMEOUT=3
GEOLOCATION_MAX_RETRIES=3
GEOLOCATION_BACKOFF_BASE=0.5
WEATHER_API_KEY=replace-with-weather-api-key
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1
WEATHER_API_TIMEOUT=5
WEATHER_API_MAX_RETRIES=3
WEATHER_API_BACKOFF_BASE=0.5
